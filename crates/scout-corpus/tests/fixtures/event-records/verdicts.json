{
 "about": "Event record files and the verdict the reader (crates/scout-corpus/src/events.rs) gives each. Run by crates/scout-corpus/tests/event_record_fixtures.rs. The reader is the one implementation of the record format: `scout events seed` reads and checks records with it. verdict: accept (read as a record), reject (skipped with a warning; `why` is a phrase of that warning), ignored (not a record file). A case with `make` has no file in records/: the tests create it (pad: text then one byte repeated up to a size; repeat: prefix, a unit repeated, suffix; hex: these bytes; symlink: a link to another case; dir: a folder).",
 "cases": [
  {
   "file": "valid-full.md",
   "verdict": "accept",
   "note": "every field; a `---` line in the body"
  },
  {
   "file": "valid-minimal.md",
   "verdict": "accept",
   "note": "id alone; the name is the id"
  },
  {
   "file": "valid-bom-crlf.md",
   "verdict": "accept",
   "note": "BOM and CRLF line ends"
  },
  {
   "file": "2026.md",
   "verdict": "accept",
   "note": "every scalar is text: the id is \"2026\""
  },
  {
   "file": "valid-nulls.md",
   "verdict": "accept",
   "note": "empty, ~ and null are no value, for single values and lists alike"
  },
  {
   "file": "valid-quoted-null.md",
   "verdict": "accept",
   "note": "a quoted null is text; an unquoted one in a list is dropped"
  },
  {
   "file": "valid-padded-id.md",
   "verdict": "accept",
   "note": "the id is trimmed before it is compared with the file name"
  },
  {
   "file": "valid-other-keys.md",
   "verdict": "accept",
   "note": "keys that are not record fields are ignored, to three levels"
  },
  {
   "file": "valid-fence-spaces.md",
   "verdict": "accept",
   "note": "whitespace after the closing ---"
  },
  {
   "file": "valid-no-final-newline.md",
   "verdict": "accept"
  },
  {
   "file": "valid-block-scalar.md",
   "verdict": "accept",
   "note": "a block scalar is a single value"
  },
  {
   "file": "valid-anchor.md",
   "verdict": "accept",
   "note": "an anchor nothing refers to"
  },
  {
   "file": "valid-dangling-merge.md",
   "verdict": "accept",
   "note": "a merged_into that names no record is a warning; the record is read"
  },
  {
   "file": "valid-contested-member.md",
   "verdict": "accept",
   "note": "a member two records claim (valid-full.md too) is a warning; both records are read"
  },
  {
   "file": "double.md.md",
   "verdict": "accept",
   "note": "every trailing .md is cut from the file name"
  },
  {
   "file": "twin  id.md",
   "verdict": "accept",
   "note": "first of two files whose ids are equal under the fold (two spaces)"
  },
  {
   "file": "at-the-cap.md",
   "verdict": "accept",
   "make": {
    "pad": {
     "text": "---\nid: at-the-cap\n---\n",
     "byte": "x",
     "bytes": 1048576
    }
   },
   "note": "exactly 1 MiB"
  },
  {
   "file": "twin id.md",
   "verdict": "reject",
   "why": "repeated or empty id",
   "note": "its id repeats twin  id.md under the fold"
  },
  {
   "file": "no-frontmatter.md",
   "verdict": "reject",
   "why": "no frontmatter"
  },
  {
   "file": "unclosed-frontmatter.md",
   "verdict": "reject",
   "why": "no frontmatter"
  },
  {
   "file": "late-frontmatter.md",
   "verdict": "reject",
   "why": "no frontmatter",
   "note": "the first line is not ---"
  },
  {
   "file": "fence-with-space.md",
   "verdict": "reject",
   "why": "no frontmatter",
   "note": "the opening line must be exactly ---"
  },
  {
   "file": "empty-frontmatter.md",
   "verdict": "reject",
   "why": "frontmatter is not a mapping"
  },
  {
   "file": "top-level-list.md",
   "verdict": "reject",
   "why": "frontmatter is not a mapping"
  },
  {
   "file": "top-level-text.md",
   "verdict": "reject",
   "why": "frontmatter is not a mapping"
  },
  {
   "file": "bad-yaml.md",
   "verdict": "reject",
   "why": "bad YAML"
  },
  {
   "file": "bad-yaml-open-quote.md",
   "verdict": "reject",
   "why": "bad YAML"
  },
  {
   "file": "no-id.md",
   "verdict": "reject",
   "why": "no id"
  },
  {
   "file": "empty-id.md",
   "verdict": "reject",
