  {
   "file": "edited-mapping.md",
   "verdict": "reject",
   "why": "edited is not a single value"
  },
  {
   "file": "merged-into-list.md",
   "verdict": "reject",
   "why": "merged_into is not a single value"
  },
  {
   "file": "members-text.md",
   "verdict": "reject",
   "why": "members is not a list"
  },
  {
   "file": "members-nested.md",
   "verdict": "reject",
   "why": "members is not a list"
  },
  {
   "file": "members-mapping.md",
   "verdict": "reject",
   "why": "members is not a list"
  },
