   "verdict": "reject",
   "why": "aliases are not read"
  },
  {
   "file": "yaml-alias-elsewhere.md",
   "verdict": "reject",
   "why": "aliases are not read",
   "note": "an alias in a key that is not a record field"
  },
  {
   "file": "complex-key.md",
   "verdict": "reject",
   "why": "not a plain name"
  },
  {
   "file": "too-deep-lists.md",
   "verdict": "reject",
   "why": "nested deeper than 3 levels"
  },
  {
   "file": "too-deep-mappings.md",
   "verdict": "reject",
   "why": "nested deeper than 3 levels"
  },
  {
   "file": "too-deep-block.md",
   "verdict": "reject",
   "why": "nested deeper than 3 levels"
  },
  {
   "file": "nested-100000-deep.md",
   "verdict": "reject",
   "why": "nested deeper than 3 levels",
   "make": {
    "repeat": {
     "prefix": "---\nid: nested-100000-deep\nextra:\n  ",
     "unit": "- ",
     "count": 100000,
     "suffix": "a\n---\n"
    }
   }
  },
  {
   "file": "not-utf8.md",
   "verdict": "reject",
   "why": "not valid UTF-8",
   "make": {
    "hex": "2d2d2d0a69643a206e6f742d757466380a6e616d653a20ff0a2d2d2d0a"
   }
  },
  {
   "file": "too-large.md",
   "verdict": "reject",
   "why": "larger than 1 MiB",
   "make": {
    "pad": {
     "text": "---\nid: too-large\n---\n",
     "byte": "x",
     "bytes": 1048577
    }
   },
   "note": "1 MiB and one byte"
  },
  {
   "file": "link.md",
   "verdict": "reject",
   "why": "not a plain file",
   "make": {
