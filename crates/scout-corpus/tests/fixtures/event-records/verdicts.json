   "note": "an error anywhere in the frontmatter, here in a second document"
  },
  {
   "file": "valid-dots.md",
   "verdict": "accept",
   "note": "dots in a value, indented in a block scalar and in the body are not a document end marker"
  },
  {
   "file": ".hidden.md",
   "verdict": "ignored",
   "note": "a name starting with . is not a record"
  },
  {
   "file": "notes.txt",
   "verdict": "ignored"
  },
  {
   "file": "UPPER.MD",
